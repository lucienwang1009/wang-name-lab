{
  "name": "wang-name-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "corpus:build": "node scripts/build-corpus.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "pnpm corpus:build && pnpm typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "pinyin-pro": "3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "opencc-js": "1.4.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
